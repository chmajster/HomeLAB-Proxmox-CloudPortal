[Unit]
Description=Algen Cloud Portal noVNC WebSocket Gateway
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/cloudportal
ExecStart=/usr/bin/php /var/www/cloudportal/bin/console-gateway.php --listen=127.0.0.1:6080
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/cloudportal
UMask=0077

[Install]
WantedBy=multi-user.target
